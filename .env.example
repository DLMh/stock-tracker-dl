# PostgreSQL Database URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth Secret
AUTH_SECRET="your-generated-secret-key"
NEXTAUTH_URL="http://localhost:3000"
